# ==============================================================================
# FINGUARD-AI RUNTIME CONFIGURATION CONTRACT (.env.example)
# Institutional Regulatory Compliance & Audit Pipeline
# ==============================================================================

# Service Identification
PROJECT_NAME="FinGuard Compliance & Regulatory Audit Pipeline"
VERSION="1.0.0"
ENVIRONMENT="development"
DEBUG=false

# Gateway & Network Bindings
API_HOST="127.0.0.1"
API_PORT=8000
DASHBOARD_PORT=8501
CORS_ORIGINS="http://localhost:3000,http://localhost:8501"
MAX_UPLOAD_SIZE_BYTES=10485760

# Statutory Scoring Thresholds (0 - 100 Scale)
TIER1_CRITICAL_PENALTY=40
TIER2_HIGH_PENALTY=20
TIER3_CAUTION_PENALTY=10
RED_FLAG_THRESHOLD=75
ORANGE_FLAG_THRESHOLD=50
YELLOW_FLAG_THRESHOLD=25

# Storage & Telemetry
AUDIT_LOG_RETENTION_DAYS=90
ENABLE_STRUCTURED_JSON_LOGGING=true
