Set-Content -Path .gitignore -Value @"
# Virtual Environments
.venv/
venv/
ENV/
env/

# Python Bytecode & Cache
__pycache__/
*.py[cod]
*$py.class
*.egg-info/
dist/
build/

# Testing & Coverage
.coverage
htmlcov/
.pytest_cache/

# IDE & Editor Artifacts
.vscode/
.idea/
*.swp
*.swo

# Environment Variables & Local Secrets
.env
.env.local

# Temporary Audit Artifacts
batch_audit_summary.json
"@ -Encoding utf8